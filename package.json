{
  "name": "shell-ask",
  "version": "0.0.45",
  "description": "Ask LLM any question in your terminal",
  "type": "module",
  "bin": {
    "ask": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schema.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/egoist/shell-ask"
  },
  "scripts": {
    "build": "npm run gen-config-schema && tsup",
    "dev": "npm run build -- --watch",
    "prepublishOnly": "npm run build",
    "gen-config-schema": "npx tsx scripts/gen-config-schema.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.36",
    "@ai-sdk/google": "3.0.20",
    "@ai-sdk/openai": "3.0.25",
    "ai": "6.0.69",
    "cac": "^6.7.14",
    "fast-glob": "^3.3.2",
    "joycon": "^3.1.1",
    "log-update": "^6.0.0",
    "marked": "15.0.1",
    "marked-terminal": "7.2.1",
    "ollama-ai-provider": "1.2.0",
    "prompts": "2.4.2",
    "smol-toml": "^1.3.1",
    "update-notifier": "7.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "22.9.0",
    "@types/prompts": "^2.4.9",
    "@types/update-notifier": "^6.0.8",
    "colorette": "^2.0.20",
